<?xml version="1.0" encoding="utf-8"?>
<!-- Grupo de país VPNGate: cabecera expandible + contenedor de servidores -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/card_bg"
    android:layout_marginTop="8dp">

    <LinearLayout android:id="@+id/group_header"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:padding="14dp">

        <FrameLayout
            android:layout_width="36dp" android:layout_height="24dp">

            <ImageView android:id="@+id/group_flag"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitXY" />

            <TextView android:id="@+id/group_iso"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center" android:text="" android:textColor="@color/text_main"
                android:textSize="10sp" android:textStyle="bold" android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView android:id="@+id/group_name"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="@color/text_main"
                android:textSize="15sp" android:textStyle="bold" />

            <TextView android:id="@+id/group_sub"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="@color/text_muted"
                android:textSize="12sp" android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView android:id="@+id/group_chevron"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="▾" android:textColor="@color/text_muted"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/group_servers"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:visibility="gone"
        android:paddingStart="14dp" android:paddingEnd="14dp"
        android:paddingBottom="10dp" />
</LinearLayout>
