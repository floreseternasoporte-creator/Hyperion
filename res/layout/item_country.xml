<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:background="@drawable/card_bg"
    android:padding="14dp" android:layout_marginTop="8dp"
    android:gravity="center_vertical">

    <View
        android:layout_width="10dp" android:layout_height="10dp"
        android:background="@drawable/dot_idle" />

    <LinearLayout
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView android:id="@+id/country_name"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/text_main"
            android:textSize="15sp" android:textStyle="bold" />

        <TextView android:id="@+id/country_sub"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/text_muted"
            android:textSize="12sp" android:layout_marginTop="2dp" />
    </LinearLayout>

    <TextView android:id="@+id/country_badge"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Próximamente" android:textColor="@color/warn"
        android:textSize="11sp" android:textStyle="bold"
        android:letterSpacing="0.08" />
</LinearLayout>
