<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de servidor VPNGate: host, ping/sesiones/velocidad, estado -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/row_bg"
    android:padding="12dp" android:layout_marginTop="6dp">

    <View android:id="@+id/server_dot"
        android:layout_width="8dp" android:layout_height="8dp"
        android:background="@drawable/dot_idle" />

    <LinearLayout
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical"
        android:layout_marginStart="10dp">

        <TextView android:id="@+id/server_host"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/text_main"
            android:textSize="14sp" android:textStyle="bold" />

        <TextView android:id="@+id/server_stats"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/text_muted"
            android:textSize="11sp" android:layout_marginTop="2dp" />
    </LinearLayout>

    <TextView android:id="@+id/server_badge"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Conectar ›" android:textColor="@color/cyan"
        android:textSize="12sp" android:textStyle="bold" />
</LinearLayout>
