<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mobile_screen"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Cabecera -->
        <LinearLayout android:id="@+id/mobile_header"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="DATOS MÓVILES" android:textColor="@color/cyan"
                android:textSize="13sp" android:letterSpacing="0.35"
                android:layout_marginTop="12dp" />

            <TextView android:id="@+id/mobile_status"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Centro de comando de datos" android:textColor="@color/text_muted"
                android:textSize="22sp" android:textStyle="bold"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- Mi plan -->
        <LinearLayout android:id="@+id/mobile_plan_card"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="18dp" android:layout_marginTop="18dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="MI PLAN" android:textColor="@color/text_muted"
                    android:textSize="12sp" android:letterSpacing="0.25" />
                <Button android:id="@+id/mobile_plan_edit"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Cambiar" android:textColor="@color/cyan"
                    android:textSize="13sp" android:background="@null"
                    android:padding="4dp" android:minWidth="0dp" android:minHeight="0dp" />
            </LinearLayout>

            <TextView android:id="@+id/mobile_plan_used"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Sin plan configurado" android:textColor="@color/text_main"
                android:textSize="20sp" android:textStyle="bold"
                android:layout_marginTop="10dp" />

            <ProgressBar android:id="@+id/mobile_plan_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="12dp"
                android:layout_marginTop="12dp"
                android:max="1000" android:progress="0"
                android:progressDrawable="@drawable/plan_bar" />

            <TextView android:id="@+id/mobile_plan_left"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="@color/text_muted"
                android:textSize="13sp" android:layout_marginTop="10dp" />

            <TextView android:id="@+id/mobile_plan_pace"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="@color/indigo"
                android:textSize="13sp" android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <!-- Configuración del plan -->
            <LinearLayout android:id="@+id/mobile_plan_config"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone"
                android:layout_marginTop="12dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <EditText android:id="@+id/mobile_plan_gb"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginEnd="6dp"
                        android:background="@drawable/card_bg"
                        android:hint="GB del plan (ej. 8)" android:textColorHint="@color/text_muted"
                        android:textColor="@color/text_main" android:textSize="15sp"
                        android:padding="12dp" android:singleLine="true"
                        android:inputType="numberDecimal" />
                    <EditText android:id="@+id/mobile_plan_day"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="6dp"
                        android:background="@drawable/card_bg"
                        android:hint="Día del ciclo (ej. 5)" android:textColorHint="@color/text_muted"
                        android:textColor="@color/text_main" android:textSize="15sp"
                        android:padding="12dp" android:singleLine="true"
                        android:inputType="number" />
                </LinearLayout>

                <Button android:id="@+id/mobile_plan_save"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:background="@drawable/btn_primary"
                    android:text="Guardar plan" android:textColor="#FFFFFF"
                    android:textSize="15sp" android:textStyle="bold" android:padding="12dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Apps que más consumen -->
        <LinearLayout android:id="@+id/mobile_data_card"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="18dp" android:layout_marginTop="12dp">

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="APPS QUE MÁS CONSUMEN (DESDE EL ARRANQUE)" android:textColor="@color/text_muted"
                android:textSize="12sp" android:letterSpacing="0.25" />

            <TextView android:id="@+id/mobile_apps_empty"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Sin datos todavía."
                android:textColor="@color/text_muted" android:textSize="13sp"
                android:layout_marginTop="10dp" />

            <LinearLayout android:id="@+id/mobile_apps"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- Tu operadora actual -->
        <LinearLayout android:id="@+id/mobile_op_card"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="18dp" android:layout_marginTop="12dp">

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="TU OPERADORA ACTUAL" android:textColor="@color/text_muted"
                android:textSize="12sp" android:letterSpacing="0.25" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="12dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="Red" android:textColor="@color/text_muted"
                        android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/mobile_op_name" android:text="–"
                        android:textColor="@color/text_main" android:textSize="16sp" android:textStyle="bold"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="Tecnología" android:textColor="@color/text_muted"
                        android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/mobile_op_net" android:text="–"
                        android:textColor="@color/text_main" android:textSize="16sp" android:textStyle="bold"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <TextView android:id="@+id/mobile_op_sim"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="@color/text_muted"
                android:textSize="13sp" android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- Lista de espera: futura operadora -->
        <LinearLayout android:id="@+id/mobile_wait_card"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="18dp" android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="HYPERION MOBILE — FUTURA OPERADORA" android:textColor="@color/text_muted"
                android:textSize="12sp" android:letterSpacing="0.25" />

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Sin internet gratis: te avisamos cuando exista."
                android:textColor="@color/text_main" android:textSize="14sp"
                android:layout_marginTop="10dp" />

            <Button android:id="@+id/mobile_join_toggle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:background="@drawable/btn_primary"
                android:text="Unirme a la lista de espera" android:textColor="#FFFFFF"
                android:textSize="15sp" android:textStyle="bold" android:padding="12dp" />

            <LinearLayout android:id="@+id/mobile_wait_form"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">

                <EditText android:id="@+id/mobile_name"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:background="@drawable/card_bg"
                    android:hint="Tu nombre" android:textColorHint="@color/text_muted"
                    android:textColor="@color/text_main" android:textSize="15sp"
                    android:padding="12dp" android:singleLine="true" />

                <EditText android:id="@+id/mobile_email"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:background="@drawable/card_bg"
                    android:hint="Tu correo" android:textColorHint="@color/text_muted"
                    android:textColor="@color/text_main" android:textSize="15sp"
                    android:padding="12dp" android:singleLine="true"
                    android:inputType="textEmailAddress" />

                <Button android:id="@+id/mobile_join"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:background="@drawable/btn_primary"
                    android:text="Confirmar" android:textColor="#FFFFFF"
                    android:textSize="15sp" android:textStyle="bold" android:padding="12dp" />
            </LinearLayout>

            <TextView android:id="@+id/mobile_join_status"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="@color/text_muted"
                android:textSize="12sp" android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
